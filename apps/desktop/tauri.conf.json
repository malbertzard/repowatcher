{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoWatcher",
  "version": "0.1.0",
  "identifier": "dev.repowatcher.desktop",
  "build": {
    "beforeDevCommand": "cd ../../ui && trunk build",
    "devUrl": "http://127.0.0.1:3030/",
    "beforeBuildCommand": "cd ../../ui && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "RepoWatcher",
        "width": 1180,
        "height": 760,
        "url": "http://127.0.0.1:3030/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon_32.png",
      "icons/icon_128.png",
      "icons/icon_512.png",
      "icons/icon.ico"
    ],
    "targets": [
      "deb",
      "appimage"
    ]
  }
}
